# ============================================================================
# Verity — Research Intelligence & Retrieval Engine
# Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys before running.
# ============================================================================

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://verity:verity@localhost:5432/verity

# --- Redis --------------------------------------------------------------------
# Redis URL for caching and task queues
REDIS_URL=redis://localhost:6379/0

# --- LLM Configuration -------------------------------------------------------
# Base URL for the OpenAI-compatible LLM API
LLM_API_BASE=https://api.openai.com/v1

# API key for the LLM provider
LLM_API_KEY=sk-your-openai-api-key-here

# Model identifier for generation
LLM_MODEL=gpt-4o

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# Maximum tokens in LLM response
LLM_MAX_TOKENS=2048

# --- Embedding Configuration -------------------------------------------------
# Base URL for the embedding API
EMBEDDING_API_BASE=https://api.openai.com/v1

# API key for the embedding provider (can be same as LLM_API_KEY)
EMBEDDING_API_KEY=sk-your-openai-api-key-here

# Embedding model identifier
EMBEDDING_MODEL=text-embedding-3-small

# Dimensionality of embedding vectors
EMBEDDING_DIMENSIONS=1536

# --- Reranker Configuration ---------------------------------------------------
# Cross-encoder model used for reranking retrieved passages
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Number of top candidates to keep after reranking
RERANKER_TOP_K=5

# --- Chunking Configuration ---------------------------------------------------
# Maximum number of characters per chunk
CHUNK_SIZE=1024

# Character overlap between consecutive chunks
CHUNK_OVERLAP=128

# --- Retrieval Pipeline -------------------------------------------------------
# Weight assigned to BM25 scores in hybrid fusion (0.0–1.0)
BM25_WEIGHT=0.4

# Weight assigned to vector similarity scores in hybrid fusion (0.0–1.0)
VECTOR_WEIGHT=0.6

# Number of top results to retrieve from BM25 index
BM25_TOP_K=20

# Number of top results to retrieve from vector index
VECTOR_TOP_K=20

# Number of results after hybrid RRF fusion
HYBRID_TOP_K=15

# Reciprocal Rank Fusion constant (higher = more uniform blending)
RRF_K=60

# --- Context Window -----------------------------------------------------------
# Maximum tokens of context to feed into the LLM prompt
MAX_CONTEXT_TOKENS=4096

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Ingestion ----------------------------------------------------------------
# Number of concurrent workers for batch document ingestion
BATCH_INGESTION_WORKERS=4

# --- Upload Limits ------------------------------------------------------------
# Maximum file size in megabytes for document uploads
MAX_FILE_SIZE_MB=50
